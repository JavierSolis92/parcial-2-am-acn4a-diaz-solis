<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Título de la rutina -->
    <TextView
        android:id="@+id/tvTituloRutina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargando rutina..."
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"/>

    <!-- Imagen web -->
    <ImageView
        android:id="@+id/imgRutinaWeb"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0" />

    <!-- ScrollView agregado para que la lista baje sin ocultar el cronómetro -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvEjerciciosRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalles..."
            android:textSize="18sp"
            android:textColor="#333333" />
    </ScrollView>

    <!-- Temporizador -->
    <TextView
        android:id="@+id/tvTemporizador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="#007AFF"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIniciarDescanso"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Serie Completa\nDescansar 1:30"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

</LinearLayout>